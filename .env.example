# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Accounts + saved collections. Use a restricted Atlas database user in Azure.
# No URI means demo-only mode; private collection imports require an account.
# Local MongoDB and email inbox: docker compose up -d mongo mailpit
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DATABASE=vidsense
# VIDSENSE_APP_URL=http://127.0.0.1:8000
# VIDSENSE_AUTH_SESSION_SECONDS=604800
# VIDSENSE_MAX_COLLECTIONS_PER_USER=5
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=VidSense <noreply@localhost>
# SMTP_STARTTLS=false
# SMTP_SSL=false
# SMTP_USERNAME=your_smtp_username_here
# SMTP_PASSWORD=your_smtp_password_here
# Use HTTPS app URL, authenticated SMTP and TLS for a deployed site.
# VIDSENSE_APP_URL=https://vidsense.sakshamverma.dev

# Google Gemini API key (DEFAULT provider — most generous free tier)
# Get one free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional provider/model overrides. Supported providers: gemini, groq.
# VIDSENSE_PROVIDER=gemini
# VIDSENSE_GEMINI_MODEL=gemini-3.6-flash
# VIDSENSE_GROQ_MODEL=openai/gpt-oss-20b
# VIDSENSE_LLM_TIMEOUT_SECONDS=45
# VIDSENSE_LLM_MAX_RETRIES=1

# Groq API key (alternative provider) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily API key (used by the external_verify tool) — https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Cloud transcript ingestion. YouTube commonly blocks Azure/AWS/GCP IPs, so
# deployed apps should use a managed transcript provider. Local development can
# keep the default `auto` mode without this key and fetch captions directly.
# Get a free starter key at https://supadata.ai/youtube-transcript-api
# SUPADATA_API_KEY=your_supadata_api_key_here
# VIDSENSE_TRANSCRIPT_PROVIDER=auto
# VIDSENSE_TRANSCRIPT_TIMEOUT_SECONDS=90
# VIDSENSE_SUPADATA_MIN_INTERVAL_SECONDS=1.1
# Lower batches use less RAM while indexing multi-video collections.
# VIDSENSE_EMBEDDING_BATCH_SIZE=16

# Maximum number of videos imported from a customer playlist (default: 50).
# VIDSENSE_MAX_PLAYLIST_VIDEOS=50
# VIDSENSE_MAX_INPUT_SOURCES=100
# VIDSENSE_MAX_COLLECTIONS=20
# VIDSENSE_MAX_CONCURRENT_INGESTIONS=2
# VIDSENSE_MAX_CONCURRENT_RESEARCH=2
# VIDSENSE_SESSION_TTL_SECONDS=7200
# VIDSENSE_RATE_LIMIT_WINDOW_SECONDS=300
# VIDSENSE_RESEARCH_RATE_LIMIT=20
# VIDSENSE_INGEST_RATE_LIMIT=4
# VIDSENSE_MAX_TRANSCRIPT_CHARS=250000
# VIDSENSE_MAX_CORPUS_CHUNKS=3000
# VIDSENSE_JOB_LEASE_SECONDS=300
# Keep false on public installations. Enables evaluation and legacy GET streams.
# VIDSENSE_ENABLE_DEVELOPER_API=false

# Optional: enable LangSmith tracing of agent runs — https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=vidsense
